<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>page.akvaithi.synth.index</string>

    <!-- Reads Documents, extracts text, refreshes the search index. Pure Python and SQLite:
         no model runs here, so this costs nothing however often it fires. It exists because
         Arun edits his markdown on his phone, and a write made outside Synth would otherwise
         never reach the index. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>/Users/akvaithi/Developer/synth/bin/synth ingest &amp;&amp; /Users/akvaithi/Developer/synth/bin/synth index</string>
    </array>

    <key>StartInterval</key>
    <integer>1800</integer>

    <key>WorkingDirectory</key>
    <string>/Users/akvaithi/Developer/synth</string>
    <key>StandardOutPath</key>
    <string>/Users/akvaithi/Developer/synth/.state/index.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/akvaithi/Developer/synth/.state/index.err.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
