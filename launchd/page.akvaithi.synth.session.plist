<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>page.akvaithi.synth.session</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/screen</string>
        <string>-D</string>
        <string>-m</string>
        <string>-S</string>
        <string>synth</string>
        <string>/Users/akvaithi/.local/bin/claude</string>
        <string>--remote-control</string>
        <string>Synth</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>WorkingDirectory</key>
    <string>/Users/akvaithi/Developer/synth</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/akvaithi/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/akvaithi/Developer/synth/.state/session.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/akvaithi/Developer/synth/.state/session.err.log</string>
</dict>
</plist>
